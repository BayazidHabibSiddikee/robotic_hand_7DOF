  <ros2_control name="fetch_7dof" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboRos2ControlSystem</plugin>
    </hardware>
    <joint name="shoulder_pan_joint">
      <command_interface name="position">
        <param name="min">-1.6056</param>
        <param name="max">1.6056</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="shoulder_lift_joint">
      <command_interface name="position">
        <param name="min">-1.221</param>
        <param name="max">1.518</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="upperarm_roll_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="elbow_flex_joint">
