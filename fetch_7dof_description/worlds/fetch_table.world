<?xml version="1.0"?>
<!--
  fetch_table.world: Gazebo (gz-sim) scene for the fetch_7dof robot,
  reproducing the Gymnasium FetchPickAndPlace MuJoCo world
  (gymnasium_robotics/envs/assets/fetch/pick_and_place.xml):

    * floor0   - ground plane (MuJoCo: finite plane at (0.8, 0.75, 0))
    * table0   - box 0.5 x 0.7 x 0.4 m centered at (1.3, 0.75, 0.2),
                 i.e. the top surface is at z = 0.4 m (the MuJoCo geom
                 size is half-extents, so its center is at z = 0.2),
                 mass 2000 kg (immovable)
    * object0  - 5 cm cube, mass 2 kg. The env re-samples its (x, y) at
                 every reset around the gripper home (1.3419, 0.7491) with
                 offsets U(-0.15, 0.15) m (min. 0.1 m from the gripper) and
                 z = 0.42 m; the pose below is one valid sample (0.136 m from
                 the gripper home). z = 0.42 matches the documented reset
                 height; contact settles it to 0.425 m on the table top.
    * target0  - static red sphere, radius 0.02 m. The env re-samples it at
                 reset to gripper home (x, y) + U(-0.15, 0.15) m and
                 z = 0.42 + U(0, 0.45) m; the pose below is the XML default
                 (0.8, 0.75, 0.5).

  Physics: 2 ms step (500 Hz), matching the MuJoCo timestep dt = 0.002 s.
  The env's 25 Hz control rate is the ros2_control update_rate.
-->
<sdf version="1.8">
  <world name="fetch_pick_and_place">

    <physics type="ode" name="fetch_physics">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <!-- Directional light, equivalent to the MuJoCo light0. -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane. -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- table0: table top surface at z = 0.4 m (box center at z = 0.2). -->
    <model name="table0">
      <static>true</static>
      <pose>1.3 0.75 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.5 0.7 0.4</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.5 0.7 0.4</size>
            </box>
          </geometry>
          <material>
            <ambient>0.93 0.93 0.93 1</ambient>
            <diffuse>0.93 0.93 0.93 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- object0: the block to pick and place (5 cm cube, 2 kg). -->
    <model name="object0">
      <pose>1.25 0.85 0.42 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <!-- I = m * a^2 / 6 for a cube of side a = 0.05 m. -->
            <ixx>0.000833</ixx>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyy>0.000833</iyy>
            <iyz>0.0</iyz>
            <izz>0.000833</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- target0: goal marker (static red sphere, radius 0.02 m). -->
    <model name="target0">
      <static>true</static>
      <pose>0.8 0.75 0.5 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.02</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
