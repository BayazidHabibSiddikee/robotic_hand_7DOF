          <script>
            <uri>file://Gazebo/Green</uri>
            <name>Gazebo/Green</name>
          </script>
        </material>
      </visual>
    </link>
    <joint name="hand_adapter_fixed_joint" type="fixed">
      <parent>hand_mount_link</parent><child>hand_adapter_link</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>
    <joint name="hand_yaw_joint" type="revolute">
      <parent>hand_adapter_link</parent><child>hand_yaw_link</child>
      <pose>0.046 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
      <limits>
        <lower>-1.5708</lower><upper>1.5708</upper>
        <effort>40</effort><velocity>1.5</velocity>
        <dynamics><damping>0.5</damping><friction>0.1</friction></dynamics>
      </limits>
      <physics>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
      </physics>
    </joint>
    <joint name="hand_pitch_joint" type="revolute">
      <parent>hand_yaw_link</parent><child>hand_pitch_link</child>
      <pose>0.046 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
      <limits>
        <lower>-1.0472</lower><upper>1.0472</upper>
        <effort>40</effort><velocity>1.5</velocity>
        <dynamics><damping>0.5</damping><friction>0.1</friction></dynamics>
      </limits>
      <physics>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
      </physics>
    </joint>
    <joint name="hand_roll_joint" type="revolute">
      <parent>hand_pitch_link</parent><child>hand_palm_link</child>
      <pose>0.044 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
      <limits>
        <lower>-0.6109</lower><upper>0.6109</upper>
        <effort>35</effort><velocity>1.5</velocity>
        <dynamics><damping>0.5</damping><friction>0.1</friction></dynamics>
      </limits>
      <physics>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
      </physics>
    </joint>
    <joint name="knuckle_spread_L_joint" type="revolute">
      <parent>hand_palm_link</parent><child>hand_knuckle_l_link</child>
      <pose>0.118 -0.03 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
      <limits>
        <lower>0</lower><upper>0.5236</upper>
        <effort>20</effort><velocity>1.5</velocity>
        <dynamics><damping>0.5</damping><friction>0.1</friction></dynamics>
      </limits>
      <physics>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
      </physics>
    </joint>
    <joint name="knuckle_spread_R_joint" type="revolute">
      <parent>hand_palm_link</parent><child>hand_knuckle_r_link</child>
      <pose>0.118 0.03 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
      <limits>
        <lower>-0.5236</lower><upper>0</upper>
        <effort>20</effort><velocity>1.5</velocity>
        <dynamics><damping>0.5</damping><friction>0.1</friction></dynamics>
      </limits>
      <physics>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
      </physics>
    </joint>
    <joint name="finger_L_prismatic_joint" type="prismatic">
      <parent>hand_knuckle_l_link</parent><child>hand_finger_l_link</child>
      <pose>0.038 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
      <limits>
        <lower>0</lower><upper>0.05</upper>
        <effort>60</effort><velocity>1.5</velocity>
        <dynamics><damping>0.5</damping><friction>0.1</friction></dynamics>
      </limits>
      <physics>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
      </physics>
    </joint>
    <joint name="finger_R_prismatic_joint" type="prismatic">
      <parent>hand_knuckle_r_link</parent><child>hand_finger_r_link</child>
      <pose>0.038 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
      <limits>
        <lower>0</lower><upper>0.05</upper>
        <effort>60</effort><velocity>1.5</velocity>
        <dynamics><damping>0.5</damping><friction>0.1</friction></dynamics>
      </limits>
      <physics>
        <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
      </physics>
    </joint>

    <plugin name="gz::sim::systems::JointStatePublisher"
            filename="gz-sim-joint-state-publisher-system"/>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>

      <plugin name="hand_yaw_joint_motor" filename="gz-sim-joint-position-controller-system">
        <joint_name>hand_yaw_joint</joint_name>
        <cmd_topic>/hand/cmd/yaw</cmd_topic>
        <p_gain>12</p_gain>
        <i_gain>0.6</i_gain>
        <d_gain>0.4</d_gain>
        <max_effort>40</max_effort>
        <use_default_cmd>true</use_default_cmd>
        <enable_topic>false</enable_topic>
      </plugin>

      <plugin name="hand_pitch_joint_motor" filename="gz-sim-joint-position-controller-system">
        <joint_name>hand_pitch_joint</joint_name>
        <cmd_topic>/hand/cmd/pitch</cmd_topic>
        <p_gain>12</p_gain>
        <i_gain>0.6</i_gain>
        <d_gain>0.4</d_gain>
        <max_effort>40</max_effort>
        <use_default_cmd>true</use_default_cmd>
        <enable_topic>false</enable_topic>
      </plugin>

      <plugin name="hand_roll_joint_motor" filename="gz-sim-joint-position-controller-system">
        <joint_name>hand_roll_joint</joint_name>
        <cmd_topic>/hand/cmd/roll</cmd_topic>
        <p_gain>10</p_gain>
        <i_gain>0.5</i_gain>
        <d_gain>0.3</d_gain>
        <max_effort>35</max_effort>
        <use_default_cmd>true</use_default_cmd>
        <enable_topic>false</enable_topic>
      </plugin>

      <plugin name="knuckle_spread_L_joint_motor" filename="gz-sim-joint-position-controller-system">
        <joint_name>knuckle_spread_L_joint</joint_name>
        <cmd_topic>/hand/cmd/spread_l</cmd_topic>
        <p_gain>8</p_gain>
        <i_gain>0.4</i_gain>
        <d_gain>0.2</d_gain>
        <max_effort>20</max_effort>
        <use_default_cmd>true</use_default_cmd>
        <enable_topic>false</enable_topic>
      </plugin>

      <plugin name="knuckle_spread_R_joint_motor" filename="gz-sim-joint-position-controller-system">
        <joint_name>knuckle_spread_R_joint</joint_name>
        <cmd_topic>/hand/cmd/spread_r</cmd_topic>
        <p_gain>8</p_gain>
        <i_gain>0.4</i_gain>
        <d_gain>0.2</d_gain>
        <max_effort>20</max_effort>
        <use_default_cmd>true</use_default_cmd>
        <enable_topic>false</enable_topic>
      </plugin>

      <plugin name="finger_L_prismatic_joint_motor" filename="gz-sim-joint-position-controller-system">
        <joint_name>finger_L_prismatic_joint</joint_name>
        <cmd_topic>/hand/cmd/finger_l</cmd_topic>
        <p_gain>120</p_gain>
        <i_gain>5</i_gain>
        <d_gain>2</d_gain>
        <max_effort>60</max_effort>
        <use_default_cmd>true</use_default_cmd>
        <enable_topic>false</enable_topic>
      </plugin>

      <plugin name="finger_R_prismatic_joint_motor" filename="gz-sim-joint-position-controller-system">
        <joint_name>finger_R_prismatic_joint</joint_name>
        <cmd_topic>/hand/cmd/finger_r</cmd_topic>
        <p_gain>120</p_gain>
        <i_gain>5</i_gain>
        <d_gain>2</d_gain>
        <max_effort>60</max_effort>
        <use_default_cmd>true</use_default_cmd>
        <enable_topic>false</enable_topic>
      </plugin>
  </model>
</sdf>
