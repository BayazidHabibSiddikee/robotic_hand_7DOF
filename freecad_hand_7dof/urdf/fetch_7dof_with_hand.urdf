<?xml version="1.0"?>
<!-- fetch_7dof_with_hand: stock Fetch 7-axis arm + 7-DOF FreeCAD hand (Option B).
     Stock 2-finger gripper_link removed; hand mounts on wrist_roll_link.
     NEW JOINTS: hand_yaw(H1), hand_pitch(H2), hand_roll(H3),
     knuckle_spread_L/R(H4/H5), finger_L/R_prismatic(H6/H7, 0..0.05m).
     Meshes: package://freecad_hand_7dof/meshes/*.stl + arm packages.
     ros2_control in-URDF block + config/ros2_control.yaml both list H1..H7. -->
<robot name="fetch_7dof">
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0036 0.0 0.0014" />
      <mass value="70.1294" />
      <inertia ixx="1.225" ixy="0.0099" ixz="0.0062" iyy="1.2853" iyz="-0.0034" izz="0.987" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <box size="0.3 0.4 0.2" />
      </geometry>
      <material name="dark_gray">
        <color rgba="0.356 0.361 0.376 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <box size="0.3 0.4 0.2" />
      </geometry>
    </collision>
  </link>
  <joint name="torso_lift_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.086875 0 0.37743" />
    <parent link="base_link" />
    <child link="torso_lift_link" />
  </joint>
  <link name="torso_lift_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0013 -0.0009 0.2935" />
      <mass value="10.7796" />
      <inertia ixx="0.3354" ixy="0.0" ixz="-0.0162" iyy="0.3354" iyz="-0.0006" izz="0.0954" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <box size="0.3 0.3 0.6" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <box size="0.3 0.3 0.6" />
      </geometry>
    </collision>
  </link>
  <joint name="shoulder_pan_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.119525 0 0.34858" />
    <parent link="torso_lift_link" />
    <child link="shoulder_pan_link" />
    <axis xyz="0 0 1" />
    <limit effort="33.82" lower="-1.6056" upper="1.6056" velocity="1.256" />
    <dynamics damping="1.0" />
  </joint>
  <link name="shoulder_pan_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0927 -0.0056 0.0564" />
      <mass value="2.5587" />
      <inertia ixx="0.0043" ixy="-0.0001" ixz="0.001" iyy="0.0087" iyz="-0.0001" izz="0.0087" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder radius="0.06" length="0.15" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder radius="0.06" length="0.15" />
      </geometry>
    </collision>
  </link>
  <joint name="shoulder_lift_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.117 0 0.06" />
    <parent link="shoulder_pan_link" />
    <child link="shoulder_lift_link" />
    <axis xyz="0 1 0" />
    <limit effort="131.76" lower="-1.221" upper="1.518" velocity="1.454" />
    <dynamics damping="1.0" />
  </joint>
  <link name="shoulder_lift_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.1432 0.0072 -0.0001" />
      <mass value="2.6615" />
      <inertia ixx="0.0028" ixy="-0.0021" ixz="-0.0" iyy="0.0111" iyz="-0.0" izz="0.0112" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.3" />
      </geometry>
      <material name="blue">
        <color rgba="0.086 0.506 0.767 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder radius="0.05" length="0.3" />
      </geometry>
    </collision>
  </link>
  <joint name="upperarm_roll_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.219 0 0" />
    <parent link="shoulder_lift_link" />
    <child link="upperarm_roll_link" />
    <axis xyz="1 0 0" />
    <limit effort="76.94" velocity="1.571" />
    <dynamics damping="5.0" />
  </joint>
  <link name="upperarm_roll_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.1165 0.0014 0.0000" />
      <mass value="2.3311" />
      <inertia ixx="0.0019" ixy="-0.0001" ixz="0.0" iyy="0.0045" iyz="0.0" izz="0.0047" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder radius="0.045" length="0.25" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder radius="0.045" length="0.25" />
      </geometry>
    </collision>
  </link>
  <joint name="elbow_flex_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.133 0 0" />
    <parent link="upperarm_roll_link" />
    <child link="elbow_flex_link" />
    <axis xyz="0 1 0" />
    <limit effort="66.18" lower="-2.251" upper="2.251" velocity="1.521" />
    <dynamics damping="1.0" />
  </joint>
  <link name="elbow_flex_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.1279 0.0073 0.0000" />
      <mass value="2.1299" />
      <inertia ixx="0.0024" ixy="-0.0016" ixz="0.0" iyy="0.0082" iyz="-0.0" izz="0.0084" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder radius="0.04" length="0.28" />
      </geometry>
      <material name="blue">
        <color rgba="0.086 0.506 0.767 1" />
