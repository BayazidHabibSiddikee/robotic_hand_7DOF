        <inertia>
          <ixx>0.00000415</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000007625</iyy><iyz>0</iyz><izz>0.000006284</izz>
        </inertia>
      </inertial>
      <collision name="hand_knuckle_l_link_collision">
        <geometry><mesh><uri>meshes/hand_knuckle_l_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
      </collision>
      <visual name="hand_knuckle_l_link_visual">
