  <gazebo reference="base_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/DarkGray</material>
  </gazebo>
  <gazebo reference="torso_lift_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="shoulder_pan_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="shoulder_lift_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="upperarm_roll_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="elbow_flex_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="forearm_roll_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="wrist_flex_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="wrist_roll_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo>
    <plugin name="gz::sim::systems::JointStatePublisher" filename="libgz-sim8-joint-state-publisher-system.so" />
  </gazebo>
  <ros2_control name="fetch_7dof" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboRos2ControlSystem</plugin>
    </hardware>
    <joint name="shoulder_pan_joint">
      <command_interface name="position">
        <param name="min">-1.6056</param>
        <param name="max">1.6056</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="shoulder_lift_joint">
      <command_interface name="position">
        <param name="min">-1.221</param>
        <param name="max">1.518</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="upperarm_roll_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="elbow_flex_joint">
      <command_interface name="position">
        <param name="min">-2.251</param>
        <param name="max">2.251</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="forearm_roll_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="wrist_flex_joint">
      <command_interface name="position">
        <param name="min">-2.16</param>
        <param name="max">2.16</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="wrist_roll_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="hand_yaw_joint">
      <command_interface name="position">
        <param name="min">-1.5708</param>
        <param name="max">1.5708</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="hand_pitch_joint">
      <command_interface name="position">
        <param name="min">-1.0472</param>
        <param name="max">1.0472</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="hand_roll_joint">
      <command_interface name="position">
        <param name="min">-0.6109</param>
        <param name="max">0.6109</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="knuckle_spread_L_joint">
