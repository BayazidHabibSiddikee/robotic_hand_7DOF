        <inertia>
          <ixx>0.000061599</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000037267</iyy><iyz>0</iyz><izz>0.000063262</izz>
        </inertia>
      </inertial>
      <collision name="hand_pitch_link_collision">
        <geometry><mesh><uri>meshes/hand_pitch_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
