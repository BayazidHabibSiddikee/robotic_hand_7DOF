  <joint name="hand_mount_fixed" type="fixed">
    <origin xyz="0.16645 0 0" />
    <parent link="wrist_roll_link" />
    <child link="hand_adapter_link" />
  </joint>
  <joint name="hand_yaw_joint" type="revolute">
    <origin xyz="0.03 0 0" />
    <parent link="hand_adapter_link" />
    <child link="hand_yaw_link" />
    <axis xyz="0 0 1" />
    <limit effort="10" lower="-1.5708" upper="1.5708" velocity="2.0" />
