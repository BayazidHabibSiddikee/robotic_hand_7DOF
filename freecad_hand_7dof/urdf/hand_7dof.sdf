    <link name="hand_finger_r_link">
      <inertial>
        <pose>0 -0.000757 0.037106 0 0 0</pose>
        <mass>0.052419288</mass>
        <inertia>
          <ixx>0.000024547</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.000026998</iyy><iyz>-0.000000203</iyz><izz>0.000006448</izz>
        </inertia>
      </inertial>
      <collision name="hand_finger_r_link_collision">
        <geometry><mesh><uri>meshes/hand_finger_r_link.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
      </collision>
