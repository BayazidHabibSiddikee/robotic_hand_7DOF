<?xml version="1.0"?>
<sdf version="1.9">
  <model name="hand_7dof">
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>
    <self_collide>false</self_collide>

    <link name="hand_mount_link">
      <inertial><pose>0 0 0 0 0 0</pose><mass>0.001</mass>
        <inertia><ixx>1e-06</ixx><ixy>0</ixy><ixz>0</ixz>
                 <iyy>1e-06</iyy><iyz>0</iyz><izz>1e-06</izz></inertia>
      </inertial>
    </link>
    <link name="hand_adapter_link">
