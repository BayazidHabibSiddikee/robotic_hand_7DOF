<?xml version="1.0"?>
<!-- hand_7dof.urdf: 7-DOF hand with motor + gearbox on every joint. Option B = Fetch 2-finger gripper + 5 wrist/palm DOF.
     Mounts on fetch_7dof wrist_roll_link at the gripper_axis origin (0.16645 0 0).
     Chain per joint: parent_link -> motor_link -> gearbox_link -> [joint] -> child_link
     Each motor is a Maxon-style DC motor with planetary gearhead.
     Gazebo sim: see hand_7dof_gazebo.xacro for JointPositionController plugins.
     Meshes in ../freecad_hand_7dof/meshes/*.stl. L = -Y, R = +Y (Fetch convention).
-->
<robot name="hand_7dof">
  <link name="hand_adapter_link">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://freecad_hand_7dof/meshes/hand_adapter_link.stl"/></geometry></visual>
    <collision><origin xyz="0 0 0"/><geometry><mesh filename="package://freecad_hand_7dof/meshes/hand_adapter_link.stl"/></geometry></collision>
    <inertial><origin xyz="0.01 0 0"/><mass value="0.12"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
  </link>
  <joint name="hand_mount_fixed" type="fixed">
    <origin xyz="0.16645 0 0"/><parent link="wrist_roll_link"/><child link="hand_adapter_link"/>
  </joint>
  <!-- H1 motor + gearbox -->
  <link name="hand_yaw_motor_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder length="0.030" radius="0.0225"/></geometry><material name="Gazebo/DarkGray"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.030" radius="0.0225"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.150"/><inertia ixx="5.0625e-05" ixy="0" ixz="0" iyy="5.0625e-05" iyz="0" izz="3.7969e-05"/></inertial>
  </link>
  <joint name="hand_yaw_motor_fixed" type="fixed">
    <origin xyz="0.03 0 0"/><parent link="hand_adapter_link"/><child link="hand_yaw_motor_link"/>
  </joint>
  <link name="hand_yaw_gearbox_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder length="0.040" radius="0.025"/></geometry><material name="Gazebo/Black"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.040" radius="0.025"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.200"/><inertia ixx="1.2750e-04" ixy="0" ixz="0" iyy="1.2750e-04" iyz="0" izz="6.2500e-05"/></inertial>
  </link>
  <joint name="hand_yaw_gearbox_fixed" type="fixed">
    <origin xyz="0 0 0"/><parent link="hand_yaw_motor_link"/><child link="hand_yaw_gearbox_link"/>
  </joint>
  <link name="hand_yaw_link">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://freecad_hand_7dof/meshes/hand_yaw_link.stl"/></geometry></visual>
    <collision><origin xyz="0 0 0"/><geometry><mesh filename="package://freecad_hand_7dof/meshes/hand_yaw_link.stl"/></geometry></collision>
    <inertial><mass value="0.15"/><origin xyz="0 0 0"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
  </link>
  <joint name="hand_yaw_joint" type="revolute">
    <origin xyz="0 0 0"/><parent link="hand_yaw_gearbox_link"/><child link="hand_yaw_link"/>
    <axis xyz="0 0 1"/><limit effort="10" lower="-1.5708" upper="1.5708" velocity="2.0"/>
    <transmission>
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="hand_yaw_joint"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
      <actuator name="hand_yaw_motor"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface><mechanicalReduction>10.0</mechanicalReduction></actuator>
    </transmission>
  </joint>
  <link name="hand_pitch_link">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://freecad_hand_7dof/meshes/hand_pitch_link.stl"/></geometry></visual>
    <collision><origin xyz="0 0 0"/><geometry><mesh filename="package://freecad_hand_7dof/meshes/hand_pitch_link.stl"/></geometry></collision>
    <inertial><mass value="0.12"/><origin xyz="0 0 0"/><inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/></inertial>
  </link>
  <!-- H2 motor + gearbox -->
  <link name="hand_pitch_motor_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder length="0.030" radius="0.0225"/></geometry><material name="Gazebo/DarkGray"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.030" radius="0.0225"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.150"/><inertia ixx="5.0625e-05" ixy="0" ixz="0" iyy="5.0625e-05" iyz="0" izz="3.7969e-05"/></inertial>
  </link>
  <joint name="hand_pitch_motor_fixed" type="fixed">
    <origin xyz="0.025 0 0"/><parent link="hand_yaw_link"/><child link="hand_pitch_motor_link"/>
  </joint>
  <link name="hand_pitch_gearbox_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder length="0.040" radius="0.025"/></geometry><material name="Gazebo/Black"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.040" radius="0.025"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.200"/><inertia ixx="1.2750e-04" ixy="0" ixz="0" iyy="1.2750e-04" iyz="0" izz="6.2500e-05"/></inertial>
  </link>
  <joint name="hand_pitch_gearbox_fixed" type="fixed">
    <origin xyz="0 0 0"/><parent link="hand_pitch_motor_link"/><child link="hand_pitch_gearbox_link"/>
  </joint>
  <joint name="hand_pitch_joint" type="revolute">
    <origin xyz="0 0 0"/><parent link="hand_pitch_gearbox_link"/><child link="hand_pitch_link"/>
    <axis xyz="0 1 0"/><limit effort="10" lower="-1.0472" upper="1.0472" velocity="2.0"/>
    <transmission>
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="hand_pitch_joint"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
      <actuator name="hand_pitch_motor"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface><mechanicalReduction>10.0</mechanicalReduction></actuator>
    </transmission>
  </joint>
  <link name="hand_palm_link">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://freecad_hand_7dof/meshes/hand_palm_link.stl"/></geometry></visual>
    <collision><origin xyz="0 0 0"/><geometry><mesh filename="package://freecad_hand_7dof/meshes/hand_palm_link.stl"/></geometry></collision>
    <inertial><mass value="0.25"/><origin xyz="0.045 0 0"/><inertia ixx="2e-4" ixy="0" ixz="0" iyy="2e-4" iyz="0" izz="2e-4"/></inertial>
  </link>
  <!-- H3 motor + gearbox -->
  <link name="hand_roll_motor_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder length="0.040" radius="0.016"/></geometry><material name="Gazebo/DarkGray"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.040" radius="0.016"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.080"/><inertia ixx="3.6267e-05" ixy="0" ixz="0" iyy="3.6267e-05" iyz="0" izz="1.0240e-05"/></inertial>
  </link>
  <joint name="hand_roll_motor_fixed" type="fixed">
    <origin xyz="0.025 0 0"/><parent link="hand_pitch_link"/><child link="hand_roll_motor_link"/>
  </joint>
  <link name="hand_roll_gearbox_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder length="0.035" radius="0.019"/></geometry><material name="Gazebo/Black"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.035" radius="0.019"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.120"/><inertia ixx="6.9829e-05" ixy="0" ixz="0" iyy="6.9829e-05" iyz="0" izz="2.1660e-05"/></inertial>
  </link>
  <joint name="hand_roll_gearbox_fixed" type="fixed">
    <origin xyz="0 0 0"/><parent link="hand_roll_motor_link"/><child link="hand_roll_gearbox_link"/>
  </joint>
  <joint name="hand_roll_joint" type="revolute">
    <origin xyz="0 0 0"/><parent link="hand_roll_gearbox_link"/><child link="hand_palm_link"/>
    <axis xyz="1 0 0"/><limit effort="8" lower="-0.6109" upper="0.6109" velocity="2.5"/>
    <transmission>
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="hand_roll_joint"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
      <actuator name="hand_roll_motor"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface><mechanicalReduction>8.0</mechanicalReduction></actuator>
    </transmission>
  </joint>
  <link name="hand_knuckle_l_link">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://freecad_hand_7dof/meshes/hand_knuckle_l_link.stl"/></geometry></visual>
    <collision><origin xyz="0 0 0"/><geometry><mesh filename="package://freecad_hand_7dof/meshes/hand_knuckle_l_link.stl"/></geometry></collision>
    <inertial><mass value="0.05"/><origin xyz="0 0 0"/><inertia ixx="2e-5" ixy="0" ixz="0" iyy="2e-5" iyz="0" izz="2e-5"/></inertial>
  </link>
  <!-- H4 motor + gearbox -->
  <link name="knuckle_spread_L_motor_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder length="0.030" radius="0.011"/></geometry><material name="Gazebo/DarkGray"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.030" radius="0.011"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.050"/><inertia ixx="8.0833e-06" ixy="0" ixz="0" iyy="8.0833e-06" iyz="0" izz="3.0250e-06"/></inertial>
  </link>
  <joint name="knuckle_spread_L_motor_fixed" type="fixed">
    <origin xyz="0.105 -0.03 0"/><parent link="hand_palm_link"/><child link="knuckle_spread_L_motor_link"/>
  </joint>
  <link name="knuckle_spread_L_gearbox_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder length="0.025" radius="0.014"/></geometry><material name="Gazebo/Black"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.025" radius="0.014"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.080"/><inertia ixx="2.8833e-05" ixy="0" ixz="0" iyy="2.8833e-05" iyz="0" izz="7.8400e-06"/></inertial>
  </link>
  <joint name="knuckle_spread_L_gearbox_fixed" type="fixed">
    <origin xyz="0 0 0"/><parent link="knuckle_spread_L_motor_link"/><child link="knuckle_spread_L_gearbox_link"/>
  </joint>
  <joint name="knuckle_spread_L_joint" type="revolute">
    <origin xyz="0 0 0"/><parent link="knuckle_spread_L_gearbox_link"/><child link="hand_knuckle_l_link"/>
    <axis xyz="0 0 1"/><limit effort="3" lower="0" upper="0.5236" velocity="3.0"/>
    <transmission>
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="knuckle_spread_L_joint"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
      <actuator name="knuckle_spread_L_motor"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface><mechanicalReduction>6.0</mechanicalReduction></actuator>
    </transmission>
  </joint>
  <link name="hand_knuckle_r_link">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="package://freecad_hand_7dof/meshes/hand_knuckle_r_link.stl"/></geometry></visual>
    <collision><origin xyz="0 0 0"/><geometry><mesh filename="package://freecad_hand_7dof/meshes/hand_knuckle_r_link.stl"/></geometry></collision>
    <inertial><mass value="0.05"/><origin xyz="0 0 0"/><inertia ixx="2e-5" ixy="0" ixz="0" iyy="2e-5" iyz="0" izz="2e-5"/></inertial>
  </link>
  <!-- H5 motor + gearbox -->
  <link name="knuckle_spread_R_motor_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder length="0.030" radius="0.011"/></geometry><material name="Gazebo/DarkGray"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.030" radius="0.011"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.050"/><inertia ixx="8.0833e-06" ixy="0" ixz="0" iyy="8.0833e-06" iyz="0" izz="3.0250e-06"/></inertial>
  </link>
  <joint name="knuckle_spread_R_motor_fixed" type="fixed">
    <origin xyz="0.105 0.03 0"/><parent link="hand_palm_link"/><child link="knuckle_spread_R_motor_link"/>
  </joint>
  <link name="knuckle_spread_R_gearbox_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder length="0.025" radius="0.014"/></geometry><material name="Gazebo/Black"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.025" radius="0.014"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.080"/><inertia ixx="2.8833e-05" ixy="0" ixz="0" iyy="2.8833e-05" iyz="0" izz="7.8400e-06"/></inertial>
  </link>
  <joint name="knuckle_spread_R_gearbox_fixed" type="fixed">
    <origin xyz="0 0 0"/><parent link="knuckle_spread_R_motor_link"/><child link="knuckle_spread_R_gearbox_link"/>
  </joint>
  <joint name="knuckle_spread_R_joint" type="revolute">
    <origin xyz="0 0 0"/><parent link="knuckle_spread_R_gearbox_link"/><child link="hand_knuckle_r_link"/>
    <axis xyz="0 0 -1"/><limit effort="3" lower="0" upper="0.5236" velocity="3.0"/>
    <transmission>
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="knuckle_spread_R_joint"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
      <actuator name="knuckle_spread_R_motor"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface><mechanicalReduction>6.0</mechanicalReduction></actuator>
    </transmission>
  </joint>
  <link name="hand_finger_l_link">
    <visual><origin xyz="0 0.101425 0"/><geometry><box size="0.03 0.02 0.08"/></geometry></visual>
    <collision><origin xyz="0 0.101425 0"/><geometry><box size="0.03 0.02 0.08"/></geometry></collision>
    <inertial><mass value="0.0798"/><origin xyz="-0.01 0 0"/><inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/></inertial>
  </link>
  <!-- H6 motor + gearbox -->
  <link name="finger_L_motor_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder length="0.030" radius="0.010"/></geometry><material name="Gazebo/DarkGray"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.030" radius="0.010"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.040"/><inertia ixx="2.1500e-05" ixy="0" ixz="0" iyy="2.1500e-05" iyz="0" izz="2.0000e-06"/></inertial>
  </link>
  <joint name="finger_L_motor_fixed" type="fixed">
    <origin xyz="0.012 -0.005 0.015"/><parent link="hand_knuckle_l_link"/><child link="finger_L_motor_link"/>
  </joint>
  <link name="finger_L_gearbox_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder length="0.025" radius="0.014"/></geometry><material name="Gazebo/Black"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.025" radius="0.014"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.060"/><inertia ixx="2.1625e-05" ixy="0" ixz="0" iyy="2.1625e-05" iyz="0" izz="5.8800e-06"/></inertial>
  </link>
  <joint name="finger_L_gearbox_fixed" type="fixed">
    <origin xyz="0 0 0"/><parent link="finger_L_motor_link"/><child link="finger_L_gearbox_link"/>
  </joint>
  <joint name="finger_L_prismatic_joint" type="prismatic">
    <origin xyz="0 0 0"/><parent link="finger_L_gearbox_link"/><child link="hand_finger_l_link"/>
    <axis xyz="0 -1 0"/><limit effort="60" lower="0.0" upper="0.05" velocity="0.05"/>
    <transmission>
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="finger_L_prismatic_joint"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
      <actuator name="finger_L_motor"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface><mechanicalReduction>12.0</mechanicalReduction></actuator>
    </transmission>
  </joint>
  <link name="hand_finger_r_link">
    <visual><origin xyz="0 -0.101425 0"/><geometry><box size="0.03 0.02 0.08"/></geometry></visual>
    <collision><origin xyz="0 -0.101425 0"/><geometry><box size="0.03 0.02 0.08"/></geometry></collision>
    <inertial><mass value="0.0798"/><origin xyz="-0.01 0 0"/><inertia ixx="1e-05" ixy="0" ixz="0" iyy="1e-05" iyz="0" izz="1e-05"/></inertial>
  </link>
  <!-- H7 motor + gearbox -->
  <link name="finger_R_motor_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder length="0.030" radius="0.010"/></geometry><material name="Gazebo/DarkGray"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.030" radius="0.010"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.040"/><inertia ixx="2.1500e-05" ixy="0" ixz="0" iyy="2.1500e-05" iyz="0" izz="2.0000e-06"/></inertial>
  </link>
  <joint name="finger_R_motor_fixed" type="fixed">
    <origin xyz="0.012 0.005 0.015"/><parent link="hand_knuckle_r_link"/><child link="finger_R_motor_link"/>
  </joint>
  <link name="finger_R_gearbox_link">
    <visual><origin xyz="0 0 0"/><geometry><cylinder length="0.025" radius="0.014"/></geometry><material name="Gazebo/Black"/></visual>
    <collision><origin xyz="0 0 0"/><geometry><cylinder length="0.025" radius="0.014"/></geometry></collision>
    <inertial><origin xyz="0 0 0"/><mass value="0.060"/><inertia ixx="2.1625e-05" ixy="0" ixz="0" iyy="2.1625e-05" iyz="0" izz="5.8800e-06"/></inertial>
  </link>
  <joint name="finger_R_gearbox_fixed" type="fixed">
    <origin xyz="0 0 0"/><parent link="finger_R_motor_link"/><child link="finger_R_gearbox_link"/>
  </joint>
  <joint name="finger_R_prismatic_joint" type="prismatic">
    <origin xyz="0 0 0"/><parent link="finger_R_gearbox_link"/><child link="hand_finger_r_link"/>
    <axis xyz="0 1 0"/><limit effort="60" lower="0.0" upper="0.05" velocity="0.05"/>
    <transmission>
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="finger_R_prismatic_joint"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface></joint>
      <actuator name="finger_R_motor"><hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface><mechanicalReduction>12.0</mechanicalReduction></actuator>
    </transmission>
  </joint>
</robot>
