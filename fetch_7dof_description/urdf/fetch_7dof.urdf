<?xml version="1.0"?>
<!--
  fetch_7dof_description: 7-DOF manipulator for the Fetch pick-and-place task.

  Kinematic chain (7 arm DOF + 2 gripper DOF):
    base_link -[torso_lift_joint, FIXED]-> torso_lift_link
              -[shoulder_pan_joint]-> shoulder_pan_link
              -[shoulder_lift_joint]-> shoulder_lift_link
              -[upperarm_roll_joint]-> upperarm_roll_link
              -[elbow_flex_joint]-> elbow_flex_link
              -[forearm_roll_joint]-> forearm_roll_link
              -[wrist_flex_joint]-> wrist_flex_link
              -[wrist_roll_joint]-> wrist_roll_link
              -[gripper_axis, FIXED]-> gripper_link
              -[r/l_gripper_finger_joint, prismatic]-> r/l_gripper_finger_link
              -[grip_site_joint, FIXED]-> grip_site_link (MuJoCo robot0:grip site)

  Differences from the upstream fetch.urdf (ZebraDevs/fetch_ros, ros1 branch,
  meshes reused under BSD-3-Clause):
    * torso_lift_joint is FIXED instead of prismatic (0..0.38615 m): the Gym
      environment runs with a fixed torso, so the task robot has exactly 7 arm
      DOF. To restore the 8th DOF, change the joint type to "prismatic", add
      axis 0 0 1, limit effort=450 lower=0 upper=0.38615 velocity=0.1 and
      <dynamics damping="100.0"/>, then add position interfaces for it below.
    * Wheels, head, bellows, laser and cameras are omitted (not needed for the
      table-top pick-and-place task); add them from the upstream URDF if desired.
-->
<robot name="fetch_7dof">

  <!-- ==================== BASE ==================== -->
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0036 0.0 0.0014" />
      <mass value="70.1294" />
      <inertia ixx="1.225" ixy="0.0099" ixz="0.0062" iyy="1.2853" iyz="-0.0034" izz="0.987" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/base_link.dae" />
      </geometry>
      <material name="dark_gray">
        <color rgba="0.356 0.361 0.376 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/base_link_collision.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== TORSO (fixed) ==================== -->
  <joint name="torso_lift_joint" type="fixed">
    <origin rpy="0 0 0" xyz="-0.086875 0 0.37743" />
    <parent link="base_link" />
    <child link="torso_lift_link" />
  </joint>

  <link name="torso_lift_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0013 -0.0009 0.2935" />
      <mass value="10.7796" />
      <inertia ixx="0.3354" ixy="0.0" ixz="-0.0162" iyy="0.3354" iyz="-0.0006" izz="0.0954" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/torso_lift_link.dae" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/torso_lift_link_collision.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== ARM JOINT 1: shoulder pan (z) ==================== -->
  <joint name="shoulder_pan_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.119525 0 0.34858" />
    <parent link="torso_lift_link" />
    <child link="shoulder_pan_link" />
    <axis xyz="0 0 1" />
    <limit effort="33.82" lower="-1.6056" upper="1.6056" velocity="1.256" />
    <dynamics damping="1.0" />
  </joint>

  <link name="shoulder_pan_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0927 -0.0056 0.0564" />
      <mass value="2.5587" />
      <inertia ixx="0.0043" ixy="-0.0001" ixz="0.001" iyy="0.0087" iyz="-0.0001" izz="0.0087" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/shoulder_pan_link.dae" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/shoulder_pan_link_collision.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== ARM JOINT 2: shoulder lift (y) ==================== -->
  <joint name="shoulder_lift_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.117 0 0.06" />
    <parent link="shoulder_pan_link" />
    <child link="shoulder_lift_link" />
    <axis xyz="0 1 0" />
    <limit effort="131.76" lower="-1.221" upper="1.518" velocity="1.454" />
    <dynamics damping="1.0" />
  </joint>

  <link name="shoulder_lift_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.1432 0.0072 -0.0001" />
      <mass value="2.6615" />
      <inertia ixx="0.0028" ixy="-0.0021" ixz="-0.0" iyy="0.0111" iyz="-0.0" izz="0.0112" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/shoulder_lift_link.dae" />
      </geometry>
      <material name="blue">
        <color rgba="0.086 0.506 0.767 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/shoulder_lift_link_collision.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== ARM JOINT 3: upper arm roll (x) ==================== -->
  <joint name="upperarm_roll_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.219 0 0" />
    <parent link="shoulder_lift_link" />
    <child link="upperarm_roll_link" />
    <axis xyz="1 0 0" />
    <limit effort="76.94" velocity="1.571" />
    <dynamics damping="5.0" />
  </joint>

  <link name="upperarm_roll_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.1165 0.0014 0.0000" />
      <mass value="2.3311" />
      <inertia ixx="0.0019" ixy="-0.0001" ixz="0.0" iyy="0.0045" iyz="0.0" izz="0.0047" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/upperarm_roll_link.dae" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/upperarm_roll_link_collision.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== ARM JOINT 4: elbow flex (y) ==================== -->
  <joint name="elbow_flex_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.133 0 0" />
    <parent link="upperarm_roll_link" />
    <child link="elbow_flex_link" />
    <axis xyz="0 1 0" />
    <limit effort="66.18" lower="-2.251" upper="2.251" velocity="1.521" />
    <dynamics damping="1.0" />
  </joint>

  <link name="elbow_flex_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.1279 0.0073 0.0000" />
      <mass value="2.1299" />
      <inertia ixx="0.0024" ixy="-0.0016" ixz="0.0" iyy="0.0082" iyz="-0.0" izz="0.0084" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/elbow_flex_link.dae" />
      </geometry>
      <material name="blue">
        <color rgba="0.086 0.506 0.767 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/elbow_flex_link_collision.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== ARM JOINT 5: forearm roll (x) ==================== -->
  <joint name="forearm_roll_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.197 0 0" />
    <parent link="elbow_flex_link" />
    <child link="forearm_roll_link" />
    <axis xyz="1 0 0" />
    <limit effort="29.35" velocity="1.571" />
    <dynamics damping="5.0" />
  </joint>

  <link name="forearm_roll_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.1097 -0.0266 0.0000" />
      <mass value="1.6563" />
      <inertia ixx="0.0016" ixy="-0.0003" ixz="0.0" iyy="0.003" iyz="-0.0" izz="0.0035" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/forearm_roll_link.dae" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/forearm_roll_link_collision.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== ARM JOINT 6: wrist flex (y) ==================== -->
  <joint name="wrist_flex_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0.1245 0 0" />
    <parent link="forearm_roll_link" />
    <child link="wrist_flex_link" />
    <axis xyz="0 1 0" />
    <limit effort="25.7" lower="-2.16" upper="2.16" velocity="2.268" />
    <dynamics damping="1.0" />
  </joint>

  <link name="wrist_flex_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0882 0.0009 -0.0001" />
      <mass value="1.725" />
      <inertia ixx="0.0018" ixy="-0.0001" ixz="-0.0" iyy="0.0042" iyz="0.0" izz="0.0042" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/wrist_flex_link.dae" />
      </geometry>
      <material name="blue">
        <color rgba="0.086 0.506 0.767 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/wrist_flex_link_collision.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== ARM JOINT 7: wrist roll (x) ==================== -->
  <joint name="wrist_roll_joint" type="continuous">
    <origin rpy="0 0 0" xyz="0.1385 0 0" />
    <parent link="wrist_flex_link" />
    <child link="wrist_roll_link" />
    <axis xyz="1 0 0" />
    <limit effort="7.36" velocity="2.268" />
    <dynamics damping="5.0" />
  </joint>

  <link name="wrist_roll_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0095 0.0004 -0.0002" />
      <mass value="0.1354" />
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/wrist_roll_link.dae" />
      </geometry>
      <material name="white">
        <color rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/wrist_roll_link_collision.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== GRIPPER ==================== -->
  <joint name="gripper_axis" type="fixed">
    <origin rpy="0 0 0" xyz="0.16645 0 0" />
    <parent link="wrist_roll_link" />
    <child link="gripper_link" />
    <axis xyz="0 1 0" />
  </joint>

  <link name="gripper_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0900 -0.0001 -0.0017" />
      <mass value="1.5175" />
      <inertia ixx="0.0013" ixy="-0.0" ixz="0.0" iyy="0.0019" iyz="-0.0" izz="0.0024" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/gripper_link.dae" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/gripper_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="r_gripper_finger_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0 0.015425 0" />
    <parent link="gripper_link" />
    <child link="r_gripper_finger_link" />
    <axis xyz="0 1 0" />
    <limit effort="60" lower="0.0" upper="0.05" velocity="0.05" />
    <dynamics damping="100.0" />
  </joint>

  <link name="r_gripper_finger_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.01 0 0" />
      <mass value="0.0798" />
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0.101425 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/r_gripper_finger_link.STL" />
      </geometry>
      <material name="dark_gray">
        <color rgba="0.356 0.361 0.376 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0.101425 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/r_gripper_finger_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="l_gripper_finger_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0 -0.015425 0" />
    <parent link="gripper_link" />
    <child link="l_gripper_finger_link" />
    <axis xyz="0 -1 0" />
    <limit effort="60" lower="0.0" upper="0.05" velocity="0.05" />
    <dynamics damping="100.0" />
  </joint>

  <link name="l_gripper_finger_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.01 0 0" />
      <mass value="0.0798" />
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0" iyz="0" izz="0" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 -0.101425 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/l_gripper_finger_link.STL" />
      </geometry>
      <material name="dark_gray">
        <color rgba="0.356 0.361 0.376 1" />
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 -0.101425 0" />
      <geometry>
        <mesh filename="package://fetch_7dof_description/meshes/l_gripper_finger_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- ==================== GRIP SITE (end-effector frame) ==================== -->
  <!-- Equivalent of the MuJoCo "robot0:grip" site (grip site at
       x = +0.02 m inside gripper_link): the frame the Gymnasium
       obs/action spaces treat as the end effector. No collision,
       negligible inertia. The green sphere is only a visual marker. -->
  <joint name="grip_site_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.02 0 0" />
    <parent link="gripper_link" />
    <child link="grip_site_link" />
  </joint>

  <link name="grip_site_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <mass value="0.001" />
      <inertia ixx="1e-09" ixy="0.0" ixz="0.0" iyy="1e-09" iyz="0.0" izz="1e-09" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <sphere>
          <radius>0.005</radius>
        </sphere>
      </geometry>
      <material name="grip_site_green">
        <color rgba="0 1 0 0.5" />
      </material>
    </visual>
  </link>

  <!-- ==================== GAZEBO / ros2_control ==================== -->
  <!-- Load the ros2_control system plugin inside Gazebo (gz-sim). -->
  <gazebo>
    <plugin name="gz_ros2_control" filename="libgz_ros2_control-system.so" />
  </gazebo>

  <ros2_control name="fetch_7dof" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboRos2ControlSystem</plugin>
    </hardware>
    <!-- Arm joints: position command + position/velocity state. -->
    <joint name="shoulder_pan_joint">
      <command_interface name="position">
        <param name="min">-1.6056</param>
        <param name="max">1.6056</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="shoulder_lift_joint">
      <command_interface name="position">
        <param name="min">-1.221</param>
        <param name="max">1.518</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="upperarm_roll_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="elbow_flex_joint">
      <command_interface name="position">
        <param name="min">-2.251</param>
        <param name="max">2.251</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="forearm_roll_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="wrist_flex_joint">
      <command_interface name="position">
        <param name="min">-2.16</param>
        <param name="max">2.16</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="wrist_roll_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <!-- Gripper fingers. -->
    <joint name="r_gripper_finger_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.05</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="l_gripper_finger_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.05</param>
      </command_interface>
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>

</robot>
