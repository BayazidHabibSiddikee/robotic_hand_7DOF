    <link name="hand_knuckle_r_link">
      <inertial>
        <pose>0.014508 0 0 0 0 0</pose>
        <mass>0.034706748</mass>
        <inertia>
          <ixx>0.00000415</ixx><ixy>0</ixy><ixz>0</ixz>
